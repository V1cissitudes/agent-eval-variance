# Copy to .env and fill in. Never commit .env.

# Endpoint selection (overrides `default` in configs/endpoints.yaml)
AGENTRIG_ENDPOINT=ollama_mac

# vLLM on the RTX 5070 over Tailscale
VLLM_BASE_URL=http://<tailscale-host>:8000/v1
VLLM_API_KEY=EMPTY

# scripts/sync_runs.sh: pull runs/ from the 5070 to this machine
RUNS_REMOTE_USER=
RUNS_REMOTE_HOST=
# Use an absolute path: a leading ~ would be expanded to the *Mac* home when .env is sourced.
RUNS_REMOTE_PATH=/absolute/path/to/runs/

# Optional: Hugging Face cache location
# HF_HOME=./data/raw/hf
